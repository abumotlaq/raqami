PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=raqami
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/raqami

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Signs auth tokens and download links. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in hours (default 168 = 7 days).
# TOKEN_TTL_HOURS=168
# Frontend origin allowed to call the API ("*" = any).
CORS_ORIGIN=*
# Base URL placed in download links (default: the request's own host).
# PUBLIC_URL=http://localhost:3000
# Private folder for product files (default: ./storage).
# STORAGE_DIR=storage
# MAX_UPLOAD_MB=100

# Payment sandbox: success | failed | pending
# PAYMENT_DEFAULT_OUTCOME=success
# PAYMENT_PENDING_SECONDS=9

# Admin account created by `pnpm db:seed`.
ADMIN_EMAIL=admin@raqami.test
ADMIN_PASSWORD=admin12345
